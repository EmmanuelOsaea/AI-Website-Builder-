plugin "daisyui/theme" {
  name: " "; /* Custom name is present */
  default: true;        /* Set to true */
  prefersdark: false;
  color-scheme: "light";

  /* 2. Base/Background Colors (Gold and yellow tones) */
  --color-base-100: oklch(   );      /* Light brown background */
  --color-base-200: oklch(      );       /* Slightly darker cream for cards */
  --color-base-300: oklch(86% );       /* Deep cream for borders/dividers */
  --color-base-content: oklch(23% );   /* Dark espresso text for high readability */

  /* 3. Primary & Accent Colors (Rich Caramel & Coffee) */
  --color-primary: oklch(48% );        /* Warm Caramel Brown */
  --color-primary-content: oklch(96% );/* Crisp light text inside primary buttons */
  --color-secondary: oklch(63% );      /* Milky Latte Brown */
  --color-secondary-content: oklch(18%  );
  --color-accent: oklch(76% );         /* Light Golden Honey Accent */
  --color-accent-content: oklch(28%  );

  /* 4. Functional UI Feedback Colors */
  --color-info: oklch(70%  );
  --color-info-content: oklch(23% );
  --color-success: oklch(72% );       /* Muted Green for correct answers */
  --color-success-content: oklch(26% );
  --color-warning: oklch(80% );
  --color-warning-content: oklch(36% );
  --color-error: oklch(66% );          /* Muted Crimson for incorrect answers */
  --color-error-content: oklch(23%  );

  /* 5. UI Elements Customization (Optional) */
  --radius-selector: 0.75rem;                 /* Makes checkboxes/radios softer */
  --radius-field: 0.5rem;                     /* Input field roundness */
  --radius-box: 1rem;                         /* Quiz card roundness */
  --border: 1px;
}
