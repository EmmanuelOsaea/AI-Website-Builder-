plugin "daisyui/theme" {
  name: "Fried and Fried Chicken"; /* Custom name is present */
  default: true;        /* Set to true */
  prefersdark: false;
  color-scheme: "light";

  /* 2. Base/Background Colors (Deep Fried & Extra Crispy) */
  --color-base-100: oklch(38% 0.14 43.1);      
  --color-base-200: oklch(46% 0.17 41.8);       
  --color-base-300: oklch(29% 0.14 36.3);       
  --color-base-content: oklch(64% 0.17 62.4);   


  /* 3. Primary & Accent Colors (Light & Golden Batter) */
  --color-primary: oklch(0.75 0.13 80.0);        
  --color-primary-content: oklch(0.80 0.10 64.9);
  --color-secondary: oklch(0.81 0.15 73.5);
  --color-secondary-content: oklch(0.98 0.01 79.8)
  --color-accent: oklch(0.69 0.16 54.6); 
  --color-accent-content: oklch(0.28 0.07 49.8);

/* 4. Functional UI Feedback Colors */
  --color-info: oklch (0.85 0.00 0.0);
  --color-info-content: oklch(0.77 0.01 154.9);
  --color-success: oklch(64% 0.22 142);      
  --color-success-content: oklch(44% 0.16 142);
  --color-warning: oklch(88% 0.20 100);
  --color-warning-content: oklch(68% 0.16 95);
  --color-error: oklch(60% 0.26 25);          
  --color-error-content: oklch(40% 0.20 25);

  /* 5. UI Elements Customization (Optional) */
  --radius-selector: 0.75rem;                 /* Makes checkboxes/radios softer */
  --radius-field: 0.5rem;                     /* Input field roundness */
  --radius-box: 1rem;                         /* Prompt card roundness */
  --border: 1px;
}
